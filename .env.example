# ================================
# TON Cat Lottery Environment Configuration
# ================================
# Copy this file to .env and fill in your actual values

# ================================
# Docker Compose Ports
# ================================
FRONTEND_PORT=3000
BACKEND_PORT=8080

# ================================
# Smart Contract Addresses (Required)
# ================================
# Lottery Contract Address - Currently deployed on testnet
LOTTERY_CONTRACT_ADDRESS=EQCryV3r0cEnqgvzyWq4yNxubV517muKMYSyoaAWDpOjW1o7

# NFT Contract Address - Currently deployed on testnet
NFT_CONTRACT_ADDRESS=EQAe1Lf-KV_IPAfOQ1JJBEZRJ6_5wqyvzW9a_o7kGmpUdsVJ

# ================================
# Backend Service Configuration
# ================================
# Wallet Configuration for Backend Auto-draw Service
WALLET_MNEMONIC=your 24 word mnemonic phrase here for backend wallet

# Private Key (Generated from mnemonic - leave empty)
WALLET_PRIVATE_KEY=

# ================================
# Security Notes
# ================================
# 1. NEVER commit .env file to Git
# 2. WALLET_MNEMONIC contains sensitive information
# 3. Use separate environments (.env.dev, .env.staging, .env.prod)
# 4. For production, use secure key management solutions