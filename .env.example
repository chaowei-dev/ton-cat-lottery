# ================================
# ====== TON Cat Lottery 環境變數範本 ======
# ================================
# 複製此檔案為 .env 並填入實際值

# ================================
# ====== 全域配置 ======
# ================================
# 環境：development, staging, production
ENVIRONMENT=development

# 日誌等級：debug, info, warn, error
LOG_LEVEL=info

# ================================
# ====== Docker Compose 配置 ======
# ================================
# 前端端口
FRONTEND_PORT=3000

# ================================
# ====== 後端服務配置 ======
# ================================

# ====== 服務基礎配置 ======
PORT=8080

# ====== TON 區塊鏈配置 ======
# TON API 端點 (testnet/mainnet)
TON_API_ENDPOINT=https://testnet.toncenter.com/api/v2/
TON_NETWORK=testnet

# ====== 智能合約地址 ======
# 抽獎合約地址 (請替換為實際部署的合約地址)
LOTTERY_CONTRACT_ADDRESS=YOUR_LOTTERY_CONTRACT_ADDRESS

# NFT 合約地址 (請替換為實際部署的合約地址)
NFT_CONTRACT_ADDRESS=YOUR_NFT_CONTRACT_ADDRESS

# ====== 錢包配置 ======
# 24個助記詞 (請替換為你的實際助記詞，絕對不要提交到 Git)
WALLET_MNEMONIC=your wallet mnemonic words here replace with actual mnemonic

# 測試用私鑰 (將由助記詞生成，請不要直接填寫)
WALLET_PRIVATE_KEY=

# ====== 抽獎參數配置 ======
# 抽獎間隔
DRAW_INTERVAL=1m

# 參與人數限制
MAX_PARTICIPANTS=3
MIN_PARTICIPANTS=1

# 參與費用 (TON)
ENTRY_FEE_TON=0.01

# 是否自動抽獎
AUTO_DRAW=true

# ====== 重試機制配置 ======
RETRY_COUNT=3
RETRY_DELAY=5s

# ================================
# ====== 安全注意事項 ======
# ================================
# 1. 絕對不要將 .env 檔案提交到 Git 倉庫
# 2. WALLET_MNEMONIC 和 WALLET_PRIVATE_KEY 包含敏感資訊
# 3. 正式環境請使用更安全的密鑰管理方案
# 4. 定期更換測試用密鑰
# 5. 使用不同環境(.env.dev, .env.staging, .env.prod)分別管理