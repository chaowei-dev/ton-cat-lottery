# TON Cat Lottery Backend Configuration
# Copy this file to .env and fill in your values

# Required Configuration (必須配置)
LOTTERY_CONTRACT_ADDRESS=EQTest123...
WALLET_PRIVATE_KEY=your_private_key_here

# Common Adjustments (常用調整)
IS_TESTNET=true         # false for mainnet
POLLING_INTERVAL=30s    # How often to check contract status

# API Settings (API 配置 - 有默認值)
API_TIMEOUT=10s         # Request timeout
API_RATE_LIMIT=20       # Requests per minute
API_MIN_INTERVAL=3s     # Minimum interval between requests

# Retry Settings (重試配置 - 有默認值)  
RETRY_ATTEMPTS=3        # Max retry attempts
RETRY_BASE_DELAY=30s    # Base delay for exponential backoff