# TON Cat Lottery - Terraform Configuration Example
# Copy this file to terraform.tfvars and fill in your actual values

# GCP Configuration
project_id = "YOUR-GCP-PROJECT-ID"          # Example: ton-cat-lottery-dev-3
region     = "asia-east1"                   # (optional) GCP Region
zone       = "asia-east1-a"                 # (optional) GCP Zone

# Network Configuration
vpc_name      = "ton-cat-lottery-vpc"       # (optional) VPC Network name
subnet_name   = "ton-cat-lottery-subnet"    # (optional) Subnet name
subnet_cidr   = "10.0.0.0/16"               # (optional) Subnet CIDR range

# GKE Configuration
cluster_name        = "ton-cat-lottery-cluster"  # (optional) GKE cluster name
gke_release_channel = "REGULAR"                  # (optional) GKE release channel (RAPID, REGULAR, STABLE)

# DNS & Domain Configuration
domain_name           = "YOUR-DOMAIN.COM"               # Your primary domain
staging_subdomain     = "dev"                           # (optional) Staging subdomain (dev.yourdomain.com)
monitoring_subdomain  = "monitoring"                    # (optional) Monitoring subdomain

# Cloudflare Configuration
cloudflare_email     = "YOUR-EMAIL@EXAMPLE.COM"         # Your Cloudflare account email
cloudflare_api_token = "YOUR-CLOUDFLARE-API-TOKEN"      # Cloudflare API Token (not API Key)
cloudflare_zone_id   = "YOUR-CLOUDFLARE-ZONE-ID"        # Cloudflare Zone ID

# SSL Configuration
letsencrypt_email = "YOUR-EMAIL@EXAMPLE.COM"            # Email for Let's Encrypt notifications
ssl_issuer        = "letsencrypt-prod"                  # (optional) letsencrypt-staging or letsencrypt-prod

# Environment Configuration
environments = ["production", "staging"]                # (optional) List of environments

# Monitoring Configuration
enable_monitoring       = true                          # (optional) Enable monitoring infrastructure
prometheus_storage_size = "10Gi"                        # (optional) Prometheus storage size
grafana_storage_size    = "5Gi"                         # (optional) Grafana storage size

# Resource Labels (optional)
resource_labels = {
  project     = "ton-cat-lottery"
  environment = "multi"
  managed-by  = "terraform"
  owner       = "YOUR-NAME"
}

# ============================================================================
# SETUP INSTRUCTIONS:
# ============================================================================
#
# 1. Copy this file:
#    cp terraform.tfvars.example terraform.tfvars
#
# 2. Edit terraform.tfvars with your actual values:
#    vim terraform.tfvars
#
# 3. Get required Cloudflare values:
#    - Login to Cloudflare Dashboard
#    - Go to your domain -> Overview -> API section (right sidebar)
#    - Zone ID: Copy from right sidebar
#    - API Token: Create new token with Zone:Read, DNS:Edit permissions
#
# 4. Verify GCP setup:
#    gcloud config get-value project
#    gcloud auth list
#
# 5. Initialize Terraform:
#    terraform init
#    terraform validate
#    terraform plan
#
# ============================================================================